{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "packageManager": "pnpm@10.12.1",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:android": "vite build --mode=android",
        "build:ios": "vite build --mode=ios",
        "dev": "vite",
        "native:ios": "pnpm run build:ios && php artisan native:run ios",
        "type-check": "vue-tsc --noEmit",
        "test:frontend": "node --test tests/*.test.ts"
    },
    "imports": {
        "#nativephp": "./vendor/nativephp/mobile/resources/dist/native.js"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^25.9.5",
        "concurrently": "^9.2.4",
        "laravel-vite-plugin": "^3.2.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "@inertiajs/core": "^3.7.0",
        "@inertiajs/vue3": "^3.7.0",
        "@internationalized/date": "^3.12.3",
        "@lucide/vue": "^1.35.0",
        "@unovis/ts": "^1.6.7",
        "@unovis/vue": "^1.6.7",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vueuse/core": "^14.4.0",
        "@zxing/browser": "^0.1.5",
        "@zxing/library": "^0.21.3",
        "axios": "^1.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "reka-ui": "^2.10.4",
        "shadcn-vue": "^2.8.2",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.42"
    }
}
