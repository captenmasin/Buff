{
    "name": "buff/in-app-purchases",
    "description": "RevenueCat subscriptions for the Buff mobile app.",
    "version": "1.0.0",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Buff\\InAppPurchases\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Buff\\InAppPurchases\\InAppPurchasesServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
