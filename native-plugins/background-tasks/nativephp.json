{
    "namespace": "BackgroundTasks",
    "bridge_functions": [
        {
            "name": "BackgroundTasks.Register",
            "android": "com.buff.backgroundtasks.BackgroundTaskFunctions.Register",
            "android_params": ["context"],
            "description": "Register Laravel scheduled commands with Android WorkManager."
        },
        {
            "name": "BackgroundTasks.RegisterMealReminders",
            "android": "com.buff.backgroundtasks.BackgroundTaskFunctions.RegisterMealReminders",
            "android_params": ["activity"],
            "description": "Register daily meal reminder notifications with Android WorkManager."
        }
    ],
    "android": {
        "min_version": 33,
        "permissions": [
            "android.permission.POST_NOTIFICATIONS"
        ],
        "dependencies": {
            "implementation": [
                "androidx.work:work-runtime-ktx:2.11.2"
            ]
        }
    },
    "ios": {
        "min_version": "18.0"
    }
}
