{
    "namespace": "BackgroundTasks",
    "platforms": ["android", "ios"],
    "bridge_functions": [
        {
            "name": "BackgroundTasks.Register",
            "android": "com.buff.backgroundtasks.BackgroundTaskFunctions.Register",
            "android_params": ["context"],
            "description": "Register Laravel scheduled commands with Android WorkManager."
        },
        {
            "name": "BackgroundTasks.RegisterMealReminders",
            "android": "com.buff.backgroundtasks.BackgroundTaskFunctions.RegisterMealReminders",
            "android_params": ["activity"],
            "ios": "BackgroundTaskFunctions.RegisterMealReminders",
            "description": "Register daily meal reminder notifications."
        },
        {
            "name": "BackgroundTasks.SendNotification",
            "android": "com.buff.backgroundtasks.BackgroundTaskFunctions.SendNotification",
            "android_params": ["activity"],
            "ios": "BackgroundTaskFunctions.SendNotification",
            "description": "Send an immediate local device notification."
        }
    ],
    "android": {
        "min_version": 33,
        "permissions": [
            "android.permission.POST_NOTIFICATIONS",
            "android.permission.RECEIVE_BOOT_COMPLETED"
        ],
        "receivers": [
            {
                "name": "com.buff.backgroundtasks.MealReminderReceiver",
                "exported": false,
                "intent-filters": [
                    {
                        "action": "android.intent.action.BOOT_COMPLETED"
                    }
                ]
            }
        ],
        "init_function": "com.buff.backgroundtasks.startBackgroundTaskNotifications",
        "dependencies": {
            "implementation": [
                "androidx.work:work-runtime-ktx:2.11.2"
            ]
        }
    },
    "ios": {
        "min_version": "18.0",
        "init_function": "BackgroundTasksNotifications.start"
    },
    "assets": {
        "android": {
            "android/res/drawable/buff_notification.xml": "res/drawable/buff_notification.xml"
        }
    }
}
