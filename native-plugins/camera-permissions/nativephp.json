{
    "namespace": "CameraPermissions",
    "platforms": ["android"],
    "hooks": {
        "post_compile": "camera-permissions:install-webview-camera-access"
    },
    "android": {
        "min_version": 33,
        "permissions": [
            "android.permission.CAMERA"
        ],
        "features": [
            {
                "name": "android.hardware.camera",
                "required": false
            },
            {
                "name": "android.hardware.camera.autofocus",
                "required": false
            }
        ]
    },
    "ios": {
        "min_version": "18.0"
    }
}
