{
    "name": "buff/apple-health",
    "description": "Apple Health workout importer for Buff.",
    "version": "1.0.0",
    "type": "nativephp-plugin",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Buff\\AppleHealth\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Buff\\AppleHealth\\AppleHealthServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
